# The published run trees: regenerated by the commands in README.md.
results/beamconv*/
results/physical*/
results/oracle*/
results/*.refused-*/
results/*.error-*/
# Simulation arrays. simulate.py and prepare.py write them, and simulate.py
# needs inputs that are not public (README.md, "Running"). The sixteen arrays
# the six documents read are kept, so a checkout can validate and run the
# documents; fom.json records the sha256 of each. Everything else here is
# regenerated.
results/sim/*
results/sim_*/*
!results/sim/beam_alm_fit.npy
!results/sim/beam_svd_spectra.npy
!results/sim/beamconv_data.npy
!results/sim/fg_truth.npy
!results/sim/freqs_mhz.npy
!results/sim/oracle_data.npy
!results/sim/physical_data.npy
!results/sim/waterfall.npy
!results/sim_stress/beam_alm_fit.npy
!results/sim_stress/beam_svd_spectra.npy
!results/sim_stress/beamconv_data.npy
!results/sim_stress/fg_truth.npy
!results/sim_stress/freqs_mhz.npy
!results/sim_stress/oracle_data.npy
!results/sim_stress/physical_data.npy
!results/sim_stress/waterfall.npy
# Per-target locks the rheplicant CLI keeps beside each output tree.
results/.rheplicant-lock-*.lock
# The scored SMC and NUTS particles, 36 MB, which plots.py redraws the
# figures from; analyse.py rewrites them.
results/analysis*/posteriors.npz
# The rest of results/analysis*/ (fom.json, ablation.json and the PNGs) is kept.
